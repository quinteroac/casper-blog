# ── Gist content source ──────────────────────────────────────────
# Set these in the Vercel dashboard (Settings → Environment Variables)
# so they are available at both build time and server runtime.
#
# Option 1 (recommended): GitHub username whose public Gists become posts.
# GIST_ACCOUNT=your-github-username
#
# Option 2: Alternative key for the same purpose.
# GITHUB_USERNAME=your-github-username
#
# Option 3 (fallback): Comma-separated list of specific Gist IDs.
# GIST_IDS=abc123def456,ghi789jkl012
GIST_IDS=

# ── GitHub OAuth (Admin panel) ──────────────────────────────────
# Required for /admin authentication. Create a GitHub OAuth App at
# https://github.com/settings/developers and set the callback URL
# to https://<your-domain>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── NextAuth ────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Set to your production URL in Vercel (e.g. https://your-blog.vercel.app)
NEXTAUTH_URL=http://localhost:3000
