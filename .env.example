# GitHub username whose public Gists are used as posts (recommended).
# GIST_ACCOUNT=your-github-username
# Or use GITHUB_USERNAME as fallback.
# GITHUB_USERNAME=your-github-username

# Fallback: comma-separated list of GitHub Gist IDs (when no account is set).
# GIST_IDS=abc123def456,ghi789jkl012
GIST_IDS=
